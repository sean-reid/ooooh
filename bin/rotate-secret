#!/bin/sh
# Replaces one production secret and probes /health. The value comes in on stdin.
set -eu

usage() {
	echo "usage: bin/rotate-secret <TYPESAFE_API_KEY|ANTHROPIC_API_KEY|ELEVENLABS_API_KEY>" >&2
	echo "Reads the new value from stdin, puts it with wrangler, and probes api.ooooh.app/health." >&2
	exit 2
}

[ $# -eq 1 ] || usage
name=$1
case $name in
TYPESAFE_API_KEY) provider=Typesafe ;;
ANTHROPIC_API_KEY) provider=Anthropic ;;
ELEVENLABS_API_KEY) provider=ElevenLabs ;;
*) usage ;;
esac

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
wrangler=${WRANGLER:-npx wrangler}
api=${OOOOH_API:-https://api.ooooh.app}

if [ -t 0 ]; then
	printf 'New value for %s: ' "$name" >&2
	stty -echo
	trap 'stty echo' EXIT
	IFS= read -r value
	stty echo
	trap - EXIT
	echo >&2
else
	IFS= read -r value || true
fi
[ -n "$value" ] || {
	echo "rotate-secret: empty value" >&2
	exit 2
}

(cd "$root/worker" && printf '%s' "$value" | $wrangler secret put "$name" --env production)
unset value

probe() {
	curl -fsS -o /dev/null -w '%{http_code}' --retry 5 --retry-all-errors --retry-delay 1 "$@" || true
}

# The provider routes need an attested device, so the first call from a phone is the real check.
status=$(probe "$api/health")
if [ "$status" != 200 ]; then
	echo "$status /health"
	exit 1
fi
echo ok

echo "Revoke the old $name in the $provider console." >&2
echo "Record the date: set \"KEY_ROTATED_AT_$name\": \"$(date -u +%Y-%m-%d)\" under env.production.vars in worker/wrangler.jsonc and commit; the next deploy ships it." >&2
