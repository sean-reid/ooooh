#!/bin/sh
# Replaces one production secret and probes the route that reads it. The value comes in on stdin.
set -eu

usage() {
	echo "usage: bin/rotate-secret <TYPESAFE_API_KEY|ANTHROPIC_API_KEY|ELEVENLABS_API_KEY>" >&2
	echo "Reads the new value from stdin, puts it with wrangler, and probes api.ooooh.app." >&2
	exit 2
}

[ $# -eq 1 ] || usage
name=$1
case $name in
TYPESAFE_API_KEY)
	provider=Typesafe
	route=/v1/decide
	body='{"state":{},"recentTranscript":[],"signals":{"pauseLength":0,"speechDensity":0,"awaitingFinishedReply":false}}'
	;;
ANTHROPIC_API_KEY)
	provider=Anthropic
	route=/v1/compact
	body='{"state":{},"transcript":[{"text":"ok","start":0,"end":1}]}'
	;;
ELEVENLABS_API_KEY)
	provider=ElevenLabs
	route=/v1/speak
	body='{"text":"ok"}'
	;;
*) usage ;;
esac

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
wrangler=${WRANGLER:-npx wrangler}
api=${OOOOH_API:-https://api.ooooh.app}

if [ -t 0 ]; then
	printf 'New value for %s: ' "$name" >&2
	stty -echo
	trap 'stty echo' EXIT
	IFS= read -r value
	stty echo
	trap - EXIT
	echo >&2
else
	IFS= read -r value || true
fi
[ -n "$value" ] || {
	echo "rotate-secret: empty value" >&2
	exit 2
}

(cd "$root/worker" && printf '%s' "$value" | $wrangler secret put "$name" --env production)
unset value

probe() {
	curl -fsS -o /dev/null -w '%{http_code}' --retry 5 --retry-all-errors --retry-delay 1 "$@" || true
}

status=$(probe "$api/health")
if [ "$status" != 200 ]; then
	echo "$status /health"
	exit 1
fi
status=$(probe -X POST -H 'content-type: application/json' -H 'x-device: rotate-secret' --data "$body" "$api$route")
if [ "$status" != 200 ]; then
	echo "$status $route"
	exit 1
fi
echo ok

echo "Revoke the old $name in the $provider console." >&2
echo "Record the date: set \"KEY_ROTATED_AT_$name\": \"$(date -u +%Y-%m-%d)\" under env.production.vars in worker/wrangler.jsonc and commit; the next deploy ships it." >&2
