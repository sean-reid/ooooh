{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ooooh",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "vars": {
    "CONFIG_VERSION": "1",
    // Daily caps per provider, counted from the usage each response reports. Pick for the deployment.
    "JEV_DAILY_TOKENS": "20000000",
    "ANTHROPIC_DAILY_TOKENS": "2000000",
    "ELEVENLABS_DAILY_CHARACTERS": "20000",
    "DEVICE_MINUTE_REQUESTS": "60",
    // River, a pre-made ElevenLabs voice: neutral, calm, conversational. Override per deployment.
    "ELEVENLABS_VOICE_ID": "SAz9YHcvj6GT2YYXdXww",
    // App Attest: every provider and session route needs an assertion from an attested key.
    // The simulator cannot attest, so .dev.vars sets REQUIRE_ATTESTATION=false for local runs.
    "REQUIRE_ATTESTATION": "true",
    "APP_ATTEST_APP_ID": "C6UWR42ZAP.com.seanreid.ooooh",
    // "development" accepts keys from development-signed builds (aaguid appattestdevelop).
    "APP_ATTEST_ENVIRONMENT": "production",
    "FREE_SESSIONS_PER_MONTH": "3",
    "FREE_PROMPT_MINUTES": "20",
  },
  // Counters for the caps above, attested device keys, challenges, and free-session counts. `wrangler kv namespace create BUDGET` prints the id to paste here.
  "kv_namespaces": [{ "binding": "BUDGET", "id": "set-at-deploy" }],
  // Secrets, set with `wrangler secret put <NAME>` and read locally from .dev.vars:
  //   TYPESAFE_API_KEY    Jev, POST /v1/decide
  //   ANTHROPIC_API_KEY   Haiku, Sonnet, and Opus, POST /v1/compact, /v1/phrase, and /v1/notes
  //   ANTHROPIC_AUTH_TOKEN  short-lived OAuth token for local dev, wins over the key
  //   ELEVENLABS_API_KEY  speech synthesis, POST /v1/speak
}
