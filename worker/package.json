{
  "name": "ooooh-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "lint": "eslint .",
    "format": "prettier --write . ../tools",
    "format:check": "prettier --check . ../tools",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "wrangler types && vitest run",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.152.0"
  }
}
