{
  "name": "ooooh-worker",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "deploy:dry": "wrangler deploy --env production --dry-run --outdir dist",
    "build": "wrangler deploy --dry-run --outdir dist",
    "lint": "eslint .",
    "format": "prettier --write . ../tools",
    "format:check": "prettier --check . ../tools",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "wrangler types && vitest run && node --test test/rotate.test.mjs",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "^4.6.6"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@elevenlabs/elevenlabs-js": "^2.74.0"
  }
}
