{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sean-reid/ooooh/fixtures/synthetic/scripts/script.schema.json",
  "title": "Synthetic session script",
  "type": "object",
  "required": ["name", "summary", "utterances"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "voice": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 40 },
    "utterances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "pauseAfter"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "pauseAfter": { "type": "number", "minimum": 0, "maximum": 60 },
          "label": {
            "type": "string",
            "enum": [
              "clarify",
              "deepen",
              "reflect",
              "decide",
              "summarize",
              "challenge",
              "finished",
              "leave",
              "recall",
              "wrapUp"
            ]
          },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
